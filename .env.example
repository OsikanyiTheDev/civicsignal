# Public AWS API Gateway URL used for text-only community reports.
NEXT_PUBLIC_CIVICSIGNAL_API_URL=https://ocoudde4r4.execute-api.us-east-1.amazonaws.com

# Current public frontend URL.
NEXT_PUBLIC_SITE_URL=https://civicsignalgh.vercel.app

# Server-only Cognito settings for verified private photo evidence.
# Populate these after the Cognito Terraform deployment.
CIVICSIGNAL_API_URL=https://ocoudde4r4.execute-api.us-east-1.amazonaws.com
COGNITO_HOSTED_UI_DOMAIN=
COGNITO_CLIENT_ID=
