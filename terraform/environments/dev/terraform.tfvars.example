# Choose a globally unique name before deploying.
evidence_bucket_name     = "replace-with-unique-civicsignal-evidence-bucket"
evidence_retention_days = 90

# Add the production frontend after Vercel deployment.
allowed_origins = [
  "http://localhost:3000",
  "https://civicsignalgh.vercel.app"
]

cognito_domain_prefix = "civicsignal-dev-ACCOUNT_ID"

auth_callback_urls = [
  "http://localhost:3000/api/auth/callback",
  "https://civicsignalgh.vercel.app/api/auth/callback"
]

auth_logout_urls = [
  "http://localhost:3000",
  "https://civicsignalgh.vercel.app"
]

# Receives SNS confirmations, operational notifications, and the cost guardrail.
alert_email = "jillskillion@gmail.com"
monthly_budget_usd = 10
